# ============================================
# SECURITY HEADERS
# ============================================
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), picture-in-picture=*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' data: https://www.googletagmanager.com https://www.google-analytics.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: blob: https://placehold.co https://*.placehold.co https://res.cloudinary.com https://*.cloudinary.com https://image.tmdb.org https://www.google-analytics.com https://i.postimg.cc https://*.postimg.cc https://m.media-amazon.com https://images.unsplash.com; frame-src 'self' https: http: data:; connect-src 'self' https://fonts.googleapis.com https://api.themoviedb.org https://www.google-analytics.com https://analytics.google.com https://streamhub-research.onrender.com wss://streamhub-research.onrender.com wss://*.onrender.com https://static.cloudflareinsights.com https://cloudflareinsights.com http://localhost:8000 ws://localhost:8000;

# ============================================
# CACHE JS / CSS / SVG ASSETS FOR 1 YEAR
# (safe because Vite hashes all filenames)
# ============================================
/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

# ============================================
# CACHE STATIC IMAGE & FONT ASSETS FOR 1 YEAR
# ============================================
/static/*
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.ico
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/*.woff
  Cache-Control: public, max-age=31536000, immutable

# ============================================
# CACHE SITEMAP & ROBOTS
# ============================================
/sitemap.xml
  Cache-Control: public, max-age=86400

/robots.txt
  Cache-Control: public, max-age=604800

# ============================================
# NEVER CACHE HTML OR SERVICE WORKER
# ============================================
/*.html
  Cache-Control: no-cache, no-store, must-revalidate

/service-worker.js
  Cache-Control: no-cache, no-store, must-revalidate

